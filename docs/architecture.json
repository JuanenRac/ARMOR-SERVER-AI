      "column": 0,
      "level": "external",
      "title": "ARMOR-SERVER",
      "lines": [
        "GET /api/v1/ai/context and",
        "the grey frame of each camera;",
        "token ARMOR_AI_TOKEN"
      ]
    },
    {
      "id": "radars",
      "column": 0,
      "level": "external",
      "title": "Radars and light",
